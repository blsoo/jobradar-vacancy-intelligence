# No real secrets belong in this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

JOBRADAR_DB=jobradar.db
JOBRADAR_POLL_SECONDS=300
JOBRADAR_INBOX_POLL_SECONDS=60
JOBRADAR_EMAIL_POLL_SECONDS=60
JOBRADAR_TIMEZONE=Europe/Moscow
JOBRADAR_SCORE_THRESHOLD=70
JOBRADAR_MAX_PUSH_PER_CYCLE=3
JOBRADAR_TARGET_SALARY_RUB=70000
JOBRADAR_REMOTE_PREFERRED=true

# Semicolon-separated search phrases.
HH_SEARCH_QUERIES=стажер системный аналитик;junior системный аналитик;системный аналитик стажер;integration analyst
HH_AREA=113
HH_PER_PAGE=50
HH_USER_AGENT=JobRadar/0.2 (github.com/blsoo/jobradar-vacancy-intelligence)

# Applicant email notifications. Use an app-specific password where the mail provider supports it.
# On first successful connection JobRadar remembers the current UID and does NOT replay old mail.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX

# Legacy HH applicant OAuth hooks remain fail-closed. New applicant API app registration
# is no longer relied on by the live JobRadar runtime.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://github.com/blsoo/jobradar-vacancy-intelligence
HH_OAUTH_TOKEN=
HH_RESUME_ID=
